# Backend Environment Variables Example
# Copy to .env and adjust values.

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/appointments

# Feature toggles
# When set to 1, the appointment requests repository will use the database via Drizzle.
# When 0 or unset, an in-memory store is used (default for tests/development without DB).
USE_DB_APPOINTMENTS=0
# When set to 1, the services repository will use the database via Drizzle.
USE_DB_SERVICES=0
# When set to 1, the users repository (auth/profile) will use the database via Drizzle.
USE_DB_USERS=0

# Authentication / Security
JWT_SECRET=change_me_dev_secret
RATE_LIMIT_ENABLED=0
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100

# CORS
# In production, restrict allowed origins (comma-separated). Example:
# ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
# In dev/test, CORS is permissive by default.
ALLOWED_ORIGINS=
NODE_ENV=development
PORT=3000
