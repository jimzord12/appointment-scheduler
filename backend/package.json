{
  "name": "appointment-backend",
  "version": "0.1.0",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:db": "vitest --run tests/integration/db.happy-path.spec.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "openapi:generate": "tsx ./scripts/generate-openapi.ts",
    "db:seed": "tsx ./scripts/seed.ts",
    "dev:db": "docker compose up -d db && pnpm db:migrate && pnpm db:seed",
    "start": "node dist/app.js",
    "db:generate": "drizzle-kit generate --config=./drizzle/config.ts",
    "db:migrate": "drizzle-kit migrate --config=./drizzle/config.ts",
    "db:push": "drizzle-kit push --config=./drizzle/config.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.30.0",
    "express": "^5.0.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.1.4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "testcontainers": "^10.9.0",
    "vitest": "^3.2.4",
    "zod-openapi": "^5.4.1",
    "zod-to-openapi": "^0.2.1"
  }
}
