{
  "name": "appointment-scheduler-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for appointment scheduler web application (frontend + backend + shared)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "concurrently \"pnpm --filter ./backend dev\" \"pnpm --filter ./frontend dev\"",
    "dev:backend": "pnpm --filter ./backend dev",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -C frontend test:e2e",
    "test:e2e:ui": "pnpm -C frontend test:e2e:ui",
    "lint": "pnpm -r run lint && prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint:fix": "pnpm -r run lint:fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^1.0.112",
    "@eslint/js": "^9.0.0",
    "@google/gemini-cli": "^0.4.1",
    "@qwen-code/qwen-code": "^0.0.10",
    "babel-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,json}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
